<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>

  <!-- Add Styles Here -->
   <Style Selector="Button">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Padding" Value="15 10"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.form">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Padding" Value="30 7"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="250" />
    <Setter Property="BorderBrush" Value="#00FF40" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="50" />
  </Style>

  <Style Selector="Button.form:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#068116"/>
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
    <Setter Property="BorderBrush" Value="#44F25B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>


<Style Selector="Button.edit">
    <Setter Property="Foreground" Value="{DynamicResource EditBrush}" />
</Style>

<Style Selector="Button.delete">
    <Setter Property="Foreground" Value="{DynamicResource DeleteBrush}" />
</Style>

</Styles>
