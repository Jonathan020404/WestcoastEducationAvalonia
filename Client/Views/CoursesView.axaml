<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

      <StackPanel>
    <TextBlock Classes="pageTitle" Text="Kurser"/>

    <Button HorizontalAlignment="Left" Classes="form" MaxWidth="300" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToAddCourseCommand}">
      <StackPanel Orientation="Horizontal">
        <Label FontFamily="{DynamicResource IconFont}" Content="&#xe3d4;" Padding="0 5 5 0"/>
        <Label Content="Lägg till kurs"/>
      </StackPanel>
    </Button>

    <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 50 0 5">
      <Grid ColumnDefinitions="100,*,100,80,110,110,50,50" ShowGridLines="False">
        <Label Content="Kursnummer" />
        <Label Grid.Column="1" Content="Kursnamn" />
        <Label Grid.Column="2" Content="Kurstyp" />
        <Label Grid.Column="3" Content="Veckor" />
        <Label Grid.Column="4" Content="Startdatum" />
        <Label Grid.Column="5" Content="Slutdatum" />
        <Label Grid.Column="6" />
        <Label Grid.Column="7" />
    </Grid>
    </Border>
    <ScrollViewer Height="400">
      <ItemsControl ItemsSource="{Binding Courses}" Margin="0 10 0 0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="100,*,100,80,110,110,50,50"
                      ShowGridLines="False">

                    <Label Content="{Binding CourseNumber}" />

                    <Label Grid.Column="1"
                           Content="{Binding Title}" />

                    <Label Grid.Column="2"
                           Content="{Binding CourseType}" />

                    <Label Grid.Column="3"
                           Content="{Binding WeekAmount}" />

                    <Label Grid.Column="4"
                           Content="{Binding StartDate}" />

                    <Label Grid.Column="5"
                           Content="{Binding EndDate}" />

                    <Button Grid.Column="6"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToEditCourseCommand}"
                            CommandParameter="{Binding CourseNumber}"
                            FontFamily="{DynamicResource IconFont}"
                            Content="&#xebc6;"
                            Foreground="Green"
                            Padding="10 5 0 10" />

                    <Button Grid.Column="7"
                            Classes="danger"
                            Command="{Binding $parent[UserControl].DataContext.DeleteCommand}"
                            CommandParameter="{Binding CourseNumber}"
                            FontFamily="{DynamicResource IconFont}"
                            Content="&#xe4a6;"
                            Foreground="Red"
                            Padding="10 5 0 10" />

                </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>


</UserControl>
