
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.EditTeacherView"
             x:DataType="vm:EditTeacherViewModel">

    <StackPanel>
        <TextBlock Classes="pageTitle"
                   Text="{Binding PageTitle}" />

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="White"
                BorderThickness="0"
                Padding="0 30">

            <StackPanel>

                <Grid RowSpacing="10"
                      ColumnSpacing="10"
                      ColumnDefinitions="200,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ShowGridLines="False">

                    <Label Classes="form"
                           Grid.Row="0"
                           HorizontalAlignment="Right"
                           Content="Förnamn" />

                    <Label Classes="form"
                           Grid.Row="1"
                           HorizontalAlignment="Right"
                           Content="Efternamn" />

                    <Label Classes="form"
                           Grid.Row="2"
                           HorizontalAlignment="Right"
                           Content="E-post" />

                    <Label Classes="form"
                           Grid.Row="3"
                           HorizontalAlignment="Right"
                           Content="Telefonnummer" />

                    <Label Classes="form"
                           Grid.Row="4"
                           HorizontalAlignment="Right"
                           Content="Adress" />

                    <Label Classes="form"
                           Grid.Row="5"
                           HorizontalAlignment="Right"
                           Content="Postnummer" />

                    <Label Classes="form"
                           Grid.Row="6"
                           HorizontalAlignment="Right"
                           Content="Stad" />

                    <Label Classes="form"
                           Grid.Row="7"
                           HorizontalAlignment="Right"
                           Content="Ämnesområde" />

                    <TextBox Classes="form"
                             Grid.Column="1"
                             Grid.Row="0"
                             Width="250"
                             HorizontalAlignment="Left"
                             Text="{Binding FirstName}" />

                    <TextBox Classes="form"
                             Grid.Column="1"
                             Grid.Row="1"
                             Width="250"
                             HorizontalAlignment="Left"
                             Text="{Binding LastName}" />

                    <TextBox Classes="form"
                             Grid.Column="1"
                             Grid.Row="2"
                             Width="250"
                             HorizontalAlignment="Left"
                             Text="{Binding Email}" />

                    <TextBox Classes="form"
                             Grid.Column="1"
                             Grid.Row="3"
                             Width="250"
                             HorizontalAlignment="Left"
                             Text="{Binding PhoneNumber}" />

                    <TextBox Classes="form"
                             Grid.Column="1"
                             Grid.Row="4"
                             Width="250"
                             HorizontalAlignment="Left"
                             Text="{Binding Address}" />

                    <TextBox Classes="form"
                             Grid.Column="1"
                             Grid.Row="5"
                             Width="250"
                             HorizontalAlignment="Left"
                             Text="{Binding PostalCode}" />

                    <TextBox Classes="form"
                             Grid.Column="1"
                             Grid.Row="6"
                             Width="250"
                             HorizontalAlignment="Left"
                             Text="{Binding City}" />

                    <TextBox Classes="form"
                             Grid.Column="1"
                             Grid.Row="7"
                             Width="250"
                             HorizontalAlignment="Left"
                             Text="{Binding Field}" />

                </Grid>

                <StackPanel Spacing="20"
                            Margin="0 30 0 0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Classes="form"
                            Command="{Binding SaveCommand}">

                        <StackPanel Orientation="Horizontal">
                            <Label Padding="5"
                                   FontFamily="{DynamicResource IconFont}"
                                   Content="&#xe248;" />
                            <Label Content="Spara" />
                        </StackPanel>

                    </Button>

                    <Button Classes="form"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToTeachersCommand}">

                        <StackPanel Orientation="Horizontal">
                            <Label Padding="5"
                                   FontFamily="{DynamicResource IconFont}"
                                   Content="&#xe08a;" />
                            <Label Content="Avbryt" />
                        </StackPanel>

                    </Button>

                </StackPanel>

            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>
